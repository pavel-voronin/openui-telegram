{
  "name": "openui-telegram",
  "version": "1.0.0",
  "type": "module",
  "description": "Compile OpenUI Lang into self-contained Telegram widgets with an application-owned runtime and transport",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || ^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-voronin/openui-telegram.git"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && node scripts/build.mjs --support",
    "test": "npm run typecheck && node --experimental-test-module-mocks --test test/*.test.js",
    "test:coverage": "npm run typecheck && node --experimental-test-coverage --experimental-test-module-mocks --test-coverage-include=dist/** --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test test/*.test.js",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run test:coverage && npm run check:package",
    "demo:simple": "npm run typecheck && node examples/demo-server.mjs simple",
    "demo:full": "npm run typecheck && node examples/demo-server.mjs full",
    "demo:telegram": "npm run typecheck && node examples/telegram.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "linkedom": "^0.18.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.1.0",
    "acorn": "^8.19.0",
    "diff": "^9.0.0",
    "esbuild": "^0.25.12"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
